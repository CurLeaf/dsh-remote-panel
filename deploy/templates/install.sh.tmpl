#!/usr/bin/env bash
# dsh-remote-panel 部署脚本（由插件渲染，版本 @@VERSION@@）
#
# 幂等：重复执行不会重复写入，也不会覆盖已有的 Caddy 站点配置。
# 卸载：本脚本 --uninstall
#
# 只做两件事：装一个用户级 Caddy（数据面），装一个 system 级 EasyTier（网络面）。
set -euo pipefail

TARGET_USER='@@USER@@'
TARGET_HOME='@@HOME@@'
PROXY_PORT='@@PORT@@'
UPSTREAM_PORT='@@UPSTREAM_PORT@@'
VIRTUAL_IP='@@VIRTUAL_IP@@'
RELAY_HOST='@@RELAY_HOST@@'
ET_VERSION='@@ET_VERSION@@'
PANEL_VERSION='@@VERSION@@'
ACCESS_KEY='@@ACCESS_KEY@@'
ET_SHA_X86_64='@@ET_SHA_X86_64@@'
ET_SHA_AARCH64='@@ET_SHA_AARCH64@@'

# 路径可覆盖：便于在临时目录里做端到端演练，生产环境用默认值
ETC_DIR="${ETC_DIR:-/etc}"
UNIT_DIR="${UNIT_DIR:-/etc/systemd/system}"
BIN_DIR="${BIN_DIR:-/usr/local/bin}"

ET_UNIT='easytier-dsh-remote'
USER_UNIT='dsh-proxy'
ENV_FILE="$ETC_DIR/easytier/dsh-remote.env"
UNIT_FILE="$UNIT_DIR/$ET_UNIT.service"
CADDY_DIR="$TARGET_HOME/.config/caddy"
USER_UNIT_DIR="$TARGET_HOME/.config/systemd/user"

log() { printf '\033[1;34m[deploy]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[deploy]\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "请用 sudo 运行本脚本"

if [ "${1:-}" = "--uninstall" ]; then
	log "停止并移除服务"
	systemctl disable --now "$ET_UNIT" 2>/dev/null || true
	rm -f "$UNIT_FILE"
	systemctl daemon-reload
	rm -f "$ENV_FILE"
	runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$TARGET_USER")" \
		systemctl --user disable --now "$USER_UNIT" 2>/dev/null || true
	rm -f "$USER_UNIT_DIR/$USER_UNIT.service"
	rm -rf "$CADDY_DIR"
	log "已移除。二进制未删除（可能被其他用途复用）。"
	exit 0
fi

case "$(uname -m)" in
	x86_64) ET_ARCH=x86_64; ET_SHA="$ET_SHA_X86_64" ;;
	aarch64|arm64) ET_ARCH=aarch64; ET_SHA="$ET_SHA_AARCH64" ;;
	*) die "不支持的架构：$(uname -m)（v1 仅提供 x86_64 / aarch64）" ;;
esac
command -v systemctl >/dev/null || die "未找到 systemd"
command -v curl >/dev/null || die "缺少 curl：apt install curl"

# ---------------------------------------------------------------- EasyTier
if command -v easytier-core >/dev/null; then
	log "easytier-core 已存在：$(easytier-core --version 2>/dev/null | head -1)"
else
	log "下载 EasyTier ${ET_VERSION} (${ET_ARCH})"
	tmp="$(mktemp -d)"
	trap 'rm -rf "$tmp"' EXIT
	url="https://github.com/EasyTier/EasyTier/releases/download/v${ET_VERSION}/easytier-linux-${ET_ARCH}-v${ET_VERSION}.zip"
	curl -fsSL "$url" -o "$tmp/et.zip" || die "下载失败：$url（请检查网络或代理）"
	if [ -n "$ET_SHA" ]; then
		echo "$ET_SHA  $tmp/et.zip" | sha256sum -c - >/dev/null 2>&1 \
			|| die "sha256 校验失败：$url（下载被篡改或版本不匹配）"
		log "sha256 校验通过"
	else
		log "警告：这个版本没有收录 sha256，跳过校验"
	fi
	( cd "$tmp" && unzip -q et.zip ) || die "解压失败：$tmp/et.zip"
	core="$(find "$tmp" -name easytier-core -type f | head -1)"
	cli="$(find "$tmp" -name easytier-cli -type f | head -1)"
	[ -n "$core" ] || die "压缩包内未找到 easytier-core"
	install -d -m 755 "$BIN_DIR"
	install -m 755 "$core" "$BIN_DIR/easytier-core"
	[ -n "$cli" ] && install -m 755 "$cli" "$BIN_DIR/easytier-cli"
	log "安装完成：$("$BIN_DIR/easytier-core" --version 2>/dev/null | head -1)"
fi

# tcp-whitelist 在旧版本不存在，探测后再决定是否加
TCP_WL=""
if easytier-core --help 2>&1 | grep -q 'tcp-whitelist'; then
	TCP_WL="--tcp-whitelist ${PROXY_PORT}"
fi

install -d -m 755 "$ETC_DIR/easytier" "$UNIT_DIR"
umask 077
cat > "$ENV_FILE" <<'DSH_ENV_EOF'
@@ENV_BODY@@
DSH_ENV_EOF
chmod 600 "$ENV_FILE"

cat > "$UNIT_FILE" <<'DSH_UNIT_EOF'
@@UNIT_BODY@@
DSH_UNIT_EOF
sed -i "s#@@TCP_WHITELIST@@#${TCP_WL}#" "$UNIT_FILE"
chmod 644 "$UNIT_FILE"
systemctl daemon-reload
systemctl enable --now "$ET_UNIT"
log "EasyTier 已启动"

# ---------------------------------------------------------------- Caddy
if ! command -v caddy >/dev/null; then
	if command -v apt-get >/dev/null; then
		log "安装 Caddy（apt）"
		apt-get update -qq
		DEBIAN_FRONTEND=noninteractive apt-get install -y -qq caddy >/dev/null
	elif command -v dnf >/dev/null; then
		log "安装 Caddy（dnf）"
		dnf install -y -q 'dnf-command(copr)' >/dev/null 2>&1 || true
		dnf copr enable -y '@caddy/caddy' >/dev/null 2>&1 || true
		dnf install -y -q caddy >/dev/null
	else
		die "无法自动安装 Caddy：请手动安装后重跑（https://caddyserver.com/docs/install）"
	fi

	# apt/dnf 的 caddy 包会顺手起一个系统级实例，占住 127.0.0.1:2019 管理端口，
	# 导致我们的用户级实例无限重启。这里把它停掉——本项目固定用用户级实例。
	if systemctl list-unit-files caddy.service >/dev/null 2>&1; then
		if systemctl is-enabled --quiet caddy 2>/dev/null || systemctl is-active --quiet caddy 2>/dev/null; then
			log "停用系统级 caddy.service（改用用户级实例，避免 2019 端口冲突）"
			systemctl disable --now caddy >/dev/null 2>&1 || true
		fi
	fi
fi

install -d -m 700 -o "$TARGET_USER" -g "$(id -gn "$TARGET_USER")" "$CADDY_DIR"
install -d -m 700 -o "$TARGET_USER" -g "$(id -gn "$TARGET_USER")" "$USER_UNIT_DIR"

cat > "$CADDY_DIR/Caddyfile" <<'DSH_CADDY_EOF'
@@CADDY_BODY@@
DSH_CADDY_EOF
cat > "$USER_UNIT_DIR/$USER_UNIT.service" <<'DSH_PROXY_EOF'
@@PROXY_UNIT_BODY@@
DSH_PROXY_EOF
chown "$TARGET_USER":"$(id -gn "$TARGET_USER")" \
	"$CADDY_DIR/Caddyfile" \
	"$USER_UNIT_DIR/$USER_UNIT.service"
chmod 644 "$CADDY_DIR/Caddyfile" "$USER_UNIT_DIR/$USER_UNIT.service"

loginctl enable-linger "$TARGET_USER" >/dev/null 2>&1 || true
runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$TARGET_USER")" \
	systemctl --user daemon-reload
runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$TARGET_USER")" \
	systemctl --user enable --now "$USER_UNIT"
log "反代已启动（用户级服务，无 root 权限）"

# ---------------------------------------------------------------- 验收
log "等待虚拟 IP ${VIRTUAL_IP}"
for _ in $(seq 1 60); do
	ip -4 -o addr show 2>/dev/null | grep -q " ${VIRTUAL_IP}/" && break
	sleep 1
done
ip -4 -o addr show 2>/dev/null | grep -q " ${VIRTUAL_IP}/" \
	|| die "虚拟 IP 未就绪：检查 $ENV_FILE 与中继 ${RELAY_HOST}"

for _ in $(seq 1 30); do
	ss -ltn 2>/dev/null | grep -q ":${PROXY_PORT} " && break
	sleep 1
done
ss -ltn 2>/dev/null | grep -q ":${PROXY_PORT} " || die "反代未监听 :${PROXY_PORT}"

health="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PROXY_PORT}/healthz" || true)"
[ "$health" = "200" ] || die "healthz 未返回 200（实际 ${health}）"

PAYLOAD="$(printf '{"version":"%s","port":%s,"ip":"%s","upstream":%s,"health":"%s","key":"%s"}' \
	"$PANEL_VERSION" "$PROXY_PORT" "$VIRTUAL_IP" "$UPSTREAM_PORT" "$health" "$ACCESS_KEY" | base64 -w0)"

cat <<EOF

部署完成。

  手机 / 平板： http://${VIRTUAL_IP}:${PROXY_PORT}/
  家里局域网：  http://<本机局域网IP>:${PROXY_PORT}/

回填码（复制到「远程访问」面板）：
DSH_REMOTE_OK ${PAYLOAD}
EOF
