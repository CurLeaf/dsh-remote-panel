# dsh-remote-panel: 反代与门禁（用户级 Caddy，独立配置，不碰系统 Caddy）
# 生成者：dsh-remote-panel @@VERSION@@
{
	# admin API 保持默认（仅本机 2019）：白名单热重载依赖 `caddy reload`
	auto_https off
}

:@@PORT@@ {
	# 访问日志进 journal，供面板「最近拒绝」使用
	log {
		output stderr
		format json
		level INFO
	}

	# 第一层：来源白名单
	@lan remote_ip 127.0.0.1 ::1 @@LAN_CIDR@@ @@VIRTUAL_IP@@
	handle @lan {
		# 配对入口：路径匹配（可靠），返回同源页面做一次「同站跳转」。
		# 跨站导航不会带 SameSite=Strict 的 DSH Cookie，必须由同源页面自己发起。
		handle /pair {
			header Set-Cookie "dsh_gate=@@ACCESS_KEY@@; Max-Age=31536000; Path=/; HttpOnly; SameSite=Lax"
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><meta charset="utf-8"><title>正在连接…</title><script>const t=new URLSearchParams(location.search).get("token");location.replace(t?"/?token="+encodeURIComponent(t):"/")</script>` 200
		}

		# 诊断用：不经过任何认证
		handle /healthz {
			respond "ok" 200
		}

		# 第二层：口令门禁
		@key query k=@@ACCESS_KEY@@
		handle @key {
			# Cookie 值就是口令本身（24 位随机），而不是常量：常量能被手工伪造
			header Set-Cookie "dsh_gate=@@ACCESS_KEY@@; Max-Age=31536000; Path=/; HttpOnly; SameSite=Lax"

			# 一张二维码走完两步：带 token 时转发到令牌地址，不带则回首页
			@withToken query token=*
			handle @withToken {
				redir * /?token={query.token} 303
			}
			handle {
				redir * / 303
			}
		}

		# Caddy 默认没有 cookie 匹配器，用 Header 通配匹配替代
		@paired header Cookie "*dsh_gate=@@ACCESS_KEY@@*"
		handle @paired {
			# 关键：不重写 Host/Origin。DSH 通过 --trusted-host 接受这个 authority，
			# Cookie 因此天然同源，不需要任何注入或伪造。
			reverse_proxy 127.0.0.1:@@UPSTREAM_PORT@@
		}

		handle {
			respond "dsh-remote: access key required" 401
		}
	}

	handle {
		respond "dsh-remote: source not allowed" 403
	}
}
