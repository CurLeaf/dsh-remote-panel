{
  "name": "dsh-remote-panel",
  "version": "1.1.2",
  "description": "DSH 远程访问控制面 + 手机监看面板：部署、配对、状态，以及在手机上实时看见 agent 的每一步。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "deploy",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e/shell.mjs",
    "build:console": "node tools/build-console.mjs",
    "verify:live": "node tools/verify-live.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurLeaf/dsh-remote-panel.git"
  },
  "homepage": "https://github.com/CurLeaf/dsh-remote-panel#readme",
  "bugs": {
    "url": "https://github.com/CurLeaf/dsh-remote-panel/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "remote",
    "easytier",
    "caddy",
    "mobile"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "curleaf",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
