<?xml version="1.0" encoding="utf-8"?>
<!-- 证书已是 Let's Encrypt 公共 CA，只信系统 CA 即可。
     不再信任「用户凭据」：那会让任何装进手机的根证书都能劫持这个 App 的流量。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
